# Copie este archivo como .env y cambie los valores. El archivo .env NUNCA se sube a GitHub.

# Conexión a MongoDB (sin autenticación, instalación local por defecto)
MONGO_URI=mongodb://localhost:27017
# Con el usuario de privilegios mínimos creado por database/03_jb_dcl_usuarios.py:
# MONGO_URI=mongodb://jb_api_gastronomia:SU_CLAVE@localhost:27017/?authSource=bd_gastronomia

MONGO_DB=bd_gastronomia
MONGO_DB_NOSQL=bd_gastronomia_nosql
MONGO_API_USUARIO=jb_api_gastronomia

# Clave para firmar los tokens JWT (mínimo 32 caracteres). Genérela con:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambie_esta_clave_por_una_generada_de_minimo_32_caracteres
JWT_MINUTOS=60
