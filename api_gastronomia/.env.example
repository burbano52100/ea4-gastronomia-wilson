# Copie este archivo como .env y complete los valores. El archivo .env NUNCA se sube a GitHub.
# Este archivo sí se sube: solo dice qué variables hacen falta.

# ----- MySQL (base de datos principal: bd_gastronomia) -----
# Contraseña del usuario root de MySQL. La usa docker-compose.yml al crear el contenedor.
MYSQL_ROOT_PASSWORD=escriba_una_clave_para_root
# Servidor y puerto donde la API encuentra MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
# Usuario de la API con privilegios mínimos. Lo crea database/03_jb_dcl_usuarios.sql:
# la contraseña debe ser la misma que está en ese script.
MYSQL_USUARIO=jb_api_gastronomia
MYSQL_PASSWORD=escriba_la_clave_del_script_03
# Nombre de la base de datos
MYSQL_BD=bd_gastronomia

# ----- MongoDB (calificaciones: bd_gastronomia_nosql) -----
# Usuario y contraseña root de MongoDB. Los usa docker-compose.yml al crear el contenedor.
MONGO_ROOT_USUARIO=jb_root
MONGO_ROOT_PASSWORD=escriba_una_clave_para_root
# Servidor y puerto. Se usa 27018 para no chocar con un MongoDB instalado en Windows (27017).
MONGO_HOST=localhost
MONGO_PORT=27018
# Usuario de la API con permiso solo sobre bd_gastronomia_nosql. Lo crea database/04_jb_mongo_calificaciones.js:
# la contraseña debe ser la misma que está en ese script.
MONGO_USUARIO=jb_api_gastronomia
MONGO_PASSWORD=escriba_la_clave_del_script_04
# Nombre de la base de datos
MONGO_BD=bd_gastronomia_nosql

# ----- JWT (tokens de sesión) -----
# Clave para firmar los tokens (mínimo 32 caracteres). Genérela con:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambie_esta_clave_por_una_generada_de_minimo_32_caracteres
# Algoritmo de firma (HS256, HS384 o HS512)
JWT_ALGORITMO=HS256
# Minutos que dura un token antes de vencer
JWT_MINUTOS=60
